# Copy this file to .env before running: cp .env.example .env

# ---------------------------------------------------------------------------
# PORTS ON YOUR PC. Change these freely if something else is already using
# them. They do NOT affect anything inside the containers -- the services
# always talk to each other on their normal internal ports.
#
# ONE CATCH: if you change MINIO_PORT, change S3_PUBLIC_ENDPOINT below to
# match. That URL is handed to your browser, so it must be a port your browser
# can actually reach.
# ---------------------------------------------------------------------------
API_PORT=8000
POSTGRES_PORT=5432
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672
MINIO_PORT=9000
MINIO_UI_PORT=9001
# The image never changes between local and AWS. Only this file changes.

DATABASE_URL=postgresql+psycopg://app:app@postgres:5432/app
BROKER_URL=amqp://guest:guest@rabbitmq:5672//

S3_BUCKET=uploads
# Internal address the API/worker use to reach storage.
# Local = MinIO. On AWS = leave EMPTY so boto3 uses the real S3.
S3_ENDPOINT=http://minio:9000
# Address the BROWSER can reach. Local = localhost. On AWS = leave EMPTY.
S3_PUBLIC_ENDPOINT=http://localhost:9000

AWS_REGION=us-east-1
# Local only. On AWS you DELETE these two lines and use an IAM role instead.
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# How often the worker writes progress to the DB while reading a big file
CSV_PROGRESS_EVERY=50000

# Local only: let the API create tables on boot. Never set this on AWS.
CREATE_TABLES=true
